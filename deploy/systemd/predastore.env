# Host-local settings for predastore.service, installed to
# /etc/predastore/predastore.env.
#
# The TOML at PREDA_CONFIG describes the cluster and is meant to be identical
# on every machine. This file is the other half: what only this machine knows.
#
# Every value here is optional except PREDA_HOST_ID. s3d resolves each setting
# flag, then config, then default, so a variable left empty falls through to
# the TOML rather than overriding it with nothing.
#
# The shipped predastore.toml names the host-local paths itself, because a
# single machine has one answer for each. They are listed below commented out:
# uncomment one to override the TOML on this host alone, which is what a fleet
# running one distributed TOML wants.

# Which [[host]] in the TOML this process runs. The one value with no sensible
# default: host 1 on two machines is two hosts both claiming to be the first,
# which is a split cluster rather than a failure.
PREDA_HOST_ID=1

# The cluster topology. Distribute the same file to every host.
PREDA_CONFIG=/etc/predastore/predastore.toml

# On-disk root for this host's nodes. A blob node pointed at its own disk is a
# per-node data_dir in the TOML, not something to set here.
# PREDA_DATA_DIR=/var/lib/predastore

# The 32-byte AES-256 key protecting data at rest. Mode must be 0600 or
# stricter; the loader refuses anything a group or other can read. Generate it
# with scripts/predastore-keygen.sh and never rotate it in place.
# PREDA_ENCRYPTION_KEY=/etc/predastore/master.key

# This host's TLS identity. One keypair serves both planes: the gate presents
# it to S3 clients and the host presents it to its QUIC peers. Every host in a
# multi-host cluster must be given the same one.
# PREDA_TLS_CERT=/etc/predastore/server.pem
# PREDA_TLS_KEY=/etc/predastore/server.key

# Where raft and blob traffic listens, without a port. Empty uses the TOML's
# bind_addr, falling back to the host's addr. Set it to the private address on
# a multi-homed machine.
PREDA_BIND_ADDR=

# Where the S3 API listens, without a port. Empty uses the gate node's own
# bind_addr. Pair a private PREDA_BIND_ADDR with 0.0.0.0 here and S3 answers on
# every interface while nothing reaches consensus or shard traffic from outside.
PREDA_GATE_BIND_ADDR=

# Port serving /healthz and /readyz on PREDA_BIND_ADDR, never on the S3 port.
# It is plain HTTP with no authentication, so keep it on the private side or
# leave it at 0. Zero defers to the TOML's admin_port, absent from both runs no
# admin listener at all.
PREDA_ADMIN_PORT=0

# debug, info, warn or error.
PREDA_LOG_LEVEL=info
