# Standalone predastore, installed to /etc/predastore/predastore.toml.
#
# One machine, no control plane, no NATS: credentials and buckets are whatever
# this file declares. Copy it, replace every CHANGEME, and run
# scripts/predastore-keygen.sh before the first start.
#
# There is no [iam] table here, and that is the whole difference between
# standalone and a Spinifex deployment. Without it the gate resolves access
# keys from the [[auth]] entries below and contacts nothing.

version = 1
region = "ap-southeast-2"

# RS(1,0) is one shard on one node with no parity: redundancy is whatever sits
# under the blob node, so this wants RAID or ZFS beneath it. It is the only
# width parity 0 is legal at, and the only one a single host can run.
#
# Growing past one machine means more blob nodes and a real code — RS(2,1) over
# three hosts — plus one TLS keypair shared by every host, because peers verify
# each other against the system trust store.
[rs]
data = 1
parity = 0

# Background compactor for the blob store. Omit interval_seconds for the store
# default of 300s; compaction itself is never off.
# [compaction]
# interval_seconds = 300

[[host]]
id = 1

# The cluster plane, and the address other hosts would dial. Loopback is right
# for a single host: nothing dials in, and it keeps the admin listener below
# off the public interface.
addr = "127.0.0.1"

# /healthz and /readyz, on addr above and never on the S3 port. Plain HTTP with
# no authentication, which is why it belongs on the private side.
admin_port = 9099

# Host-local paths. A single machine has one answer for each, so they live here
# rather than in predastore.env — that file overrides them per host when the
# same TOML is distributed across a fleet.
data_dir = "/var/lib/predastore"
tls_cert = "/etc/predastore/server.pem"
tls_key = "/etc/predastore/server.key"
encryption_key = "/etc/predastore/master.key"

  # The S3 endpoint. Its own bind_addr is what makes S3 public while the
  # cluster plane above stays on loopback.
  [[host.node]]
  id = 1
  role = "gate"
  port = 8443
  bind_addr = "0.0.0.0"

  [[host.node]]
  id = 2
  role = "meta"
  port = 6660

  [[host.node]]
  id = 3
  role = "blob"
  port = 9991

# A config-defined service account. These are fully trusted: every request one
# signs is authorised, on any bucket, regardless of account_id. Treat an entry
# here as a root credential and add no more of them than are needed.
#
# account_id is mandatory. It is the owner stamped on buckets this key creates.
[[auth]]
access_key_id = "CHANGEME"
secret_access_key = "CHANGEME"
account_id = "100000000001"

# A bucket that exists at start rather than being created through the API.
# Both name and account_id are required; an entry missing account_id refuses
# the whole config, and one with an invalid name is dropped with a warning.
#
# public = true serves GET and HEAD without a signature. Leave it out unless
# the bucket is genuinely meant to be world-readable.
#
# ListBuckets does not report an entry declared here, so `aws s3 ls` comes back
# empty while head-bucket, GET and PUT all work against it.
[[bucket]]
name = "example-bucket"
region = "ap-southeast-2"
account_id = "100000000001"
public = false
